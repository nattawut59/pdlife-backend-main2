# Runtime
NODE_ENV=development
PORT=3000

# Supabase API credentials
# Copy these from the Supabase project settings. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Application-issued access tokens
# Generate a long random value for production (at least 32 characters).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Comma-separated web origins. Native mobile clients are not restricted by CORS.
CORS_ORIGIN=http://localhost:3000

# Set according to the number of trusted reverse proxies in production.
TRUST_PROXY=1

# Keep rate limiting enabled in production.
DISABLE_RATE_LIMIT=false

# Database-admin connection belongs in .env.admin, never in this tracked file:
# PDLIFE_DATABASE_ADMIN_URL=postgresql://...
