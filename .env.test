# =====================================================================
#  ค่าสำหรับรันเทสต์เท่านั้น — ไฟล์นี้ถูก commit ขึ้น git
#
#  🔴 ห้ามใส่ค่าจริงในไฟล์นี้เด็ดขาด ไม่ว่ากรณีใด
#     URL, key, secret ของจริงต้องอยู่ใน .env ซึ่งอยู่ใน .gitignore
#
#  ค่าทุกตัวที่นี่จงใจให้ "ผิดอย่างชัดเจน" — SUPABASE_URL ชี้ไปยังพอร์ตที่เชื่อมต่อไม่ได้
#  ถ้ามีคนเผลอเอาไฟล์นี้ไปใช้รันจริง มันจะพังทันทีให้รู้ตัว ไม่ใช่ทำงานเงียบๆ ไปเรื่อยๆ
#
#  เทสต์ตั้งใจให้รันโดยไม่ต้องมี Supabase — ทุกข้ออยู่ฝั่ง validation/auth/RBAC
#  ของ middleware chain ซึ่งเป็นด่านที่ต้องปฏิเสธคำขอที่ผิดก่อนจะไปถึงฐานข้อมูล
# =====================================================================

NODE_ENV=test

# พอร์ต 0 เชื่อมต่อไม่ได้เสมอ — กันไม่ให้เทสต์ไปแตะฐานข้อมูลจริงของใคร
SUPABASE_URL=http://localhost:0
SUPABASE_SERVICE_ROLE_KEY=test

JWT_SECRET=test
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:5173

# ต้องเป็น 0 เพื่อให้ rate limiter วัดจาก IP จริงของ request ในเทสต์
TRUST_PROXY=0

# ต้องเป็น false เสมอ ไม่งั้นเทสต์ของ rate limiter จะไม่มีความหมาย
DISABLE_RATE_LIMIT=false
